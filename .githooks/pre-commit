#!/usr/bin/env bash
# Blocks committing the real (secret-holding) simva-env files; only *.example.sh templates are allowed.
bad=$(git diff --cached --name-only --diff-filter=AM | grep -E '(^|/)etc/simva\.d/simva-env[^/]*\.sh$' | grep -vE '\.example\.sh$')
if [[ -n "$bad" ]]; then
    echo "ERROR: refusing to commit files that may contain secrets:" >&2
    echo "$bad" | sed 's/^/  /' >&2
    echo "Edit the *.example.sh templates instead (use placeholders like CHANGEME1234)." >&2
    exit 1
fi
